// Prisma schema — source of truth for the marketplace data model.
// ~20 tables covering the full SQL learning checklist.
// Naming: snake_case via @@map/@map, plural table names, surrogate id keys.
//
// Multi-schema: the marketplace data lives in the `public` schema, while the
// Challenges feature (challenges, hints, progress) lives in a dedicated `lab`
// schema that the read-only query-console role cannot see (see docs/plan.md §2).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "lab"]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM

  @@schema("public")
}

enum AddressType {
  BILLING
  SHIPPING

  @@schema("public")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED

  @@schema("public")
}

enum OrderChannel {
  WEB
  MOBILE
  MARKETPLACE_APP

  @@schema("public")
}

enum PaymentMethod {
  CREDIT_CARD
  PIX
  BOLETO
  PAYPAL
  WALLET

  @@schema("public")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@schema("public")
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  DAMAGED_IN_TRANSIT
  LATE_DELIVERY

  @@schema("public")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
  EXCHANGED

  @@schema("public")
}

enum DiscountType {
  PERCENT
  FIXED

  @@schema("public")
}

enum EmployeeDepartment {
  WAREHOUSE
  LOGISTICS
  CUSTOMER_SERVICE
  SALES
  FINANCE
  IT
  HR
  MARKETING

  @@schema("public")
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  PURCHASE

  @@schema("public")
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET

  @@schema("public")
}

// ─── Sellers ─────────────────────────────────────────────────────────────────

model Seller {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  country         String
  joinedAt        DateTime @map("joined_at")
  rating          Decimal  @db.Decimal(2, 1)
  isActive        Boolean  @default(true) @map("is_active")
  commissionRate  Decimal  @map("commission_rate") @db.Decimal(5, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  products        Product[]
  orderItems      OrderItem[]
  dailySnapshots  DailySalesSnapshot[]

  @@index([country])
  @@index([isActive])
  @@map("sellers")
  @@schema("public")
}

// ─── Customers ───────────────────────────────────────────────────────────────

model Customer {
  id           Int       @id @default(autoincrement())
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  birthDate    DateTime? @map("birth_date") @db.Date
  country      String
  city         String
  createdAt    DateTime  @default(now()) @map("created_at")
  loyaltyTier  LoyaltyTier @default(BRONZE) @map("loyalty_tier")
  preferences  Json      @default("{}") // jsonb
  tags         String[]  @default([])
  deletedAt    DateTime? @map("deleted_at") // soft-delete
  referredById Int?      @map("referred_by_id") // self-reference
  referredBy   Customer? @relation("CustomerReferral", fields: [referredById], references: [id], map: "fk_customer_referred_by")
  referrals    Customer[] @relation("CustomerReferral")

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  carts        Cart[]
  events       PageViewEvent[]

  @@index([country])
  @@index([loyaltyTier])
  @@index([referredById])
  @@index([deletedAt])
  @@map("customers")
  @@schema("public")
}

// ─── Addresses ───────────────────────────────────────────────────────────────

model Address {
  id          Int         @id @default(autoincrement())
  customerId  Int         @map("customer_id")
  type        AddressType
  street      String
  city        String
  state       String
  postalCode  String      @map("postal_code")
  country     String
  isDefault   Boolean     @default(false) @map("is_default")
  createdAt   DateTime    @default(now()) @map("created_at")

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "fk_address_customer")
  orders      Order[]

  @@index([customerId])
  @@index([country])
  @@map("addresses")
  @@schema("public")
}

// ─── Categories (self-referencing tree) ──────────────────────────────────────

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?       @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], map: "fk_category_parent")
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("categories")
  @@schema("public")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id             Int       @id @default(autoincrement())
  sellerId       Int       @map("seller_id")
  categoryId     Int       @map("category_id")
  name           String
  description    String?
  basePrice      Decimal   @map("base_price") @db.Decimal(12, 2)
  attributes     Json      @default("{}") // jsonb
  isPublished    Boolean   @default(true) @map("is_published")
  createdAt      DateTime  @default(now()) @map("created_at")
  discontinuedAt DateTime? @map("discontinued_at")
  weightGrams    Int?      @map("weight_grams")

  seller         Seller    @relation(fields: [sellerId], references: [id], map: "fk_product_seller")
  category       Category  @relation(fields: [categoryId], references: [id], map: "fk_product_category")
  variants       ProductVariant[]
  suppliers      ProductSupplier[]
  reviews        Review[]
  events         PageViewEvent[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([isPublished])
  @@index([discontinuedAt])
  @@map("products")
  @@schema("public")
}

// ─── Product Variants ────────────────────────────────────────────────────────

model ProductVariant {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  sku         String   @unique
  optionName  String   @map("option_name")
  optionValue String   @map("option_value")
  price       Decimal  @db.Decimal(12, 2)
  barcode     String?
  createdAt   DateTime @default(now()) @map("created_at")

  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_variant_product")
  inventory     Inventory[]
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([productId])
  @@index([optionName])
  @@map("product_variants")
  @@schema("public")
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id            Int               @id @default(autoincrement())
  name          String
  country       String
  leadTimeDays  Int               @map("lead_time_days")
  createdAt     DateTime          @default(now()) @map("created_at")

  products      ProductSupplier[]

  @@index([country])
  @@map("suppliers")
  @@schema("public")
}

// ─── Product Suppliers (M:N with payload, composite PK) ──────────────────────

model ProductSupplier {
  productId   Int     @map("product_id")
  supplierId  Int     @map("supplier_id")
  unitCost    Decimal @map("unit_cost") @db.Decimal(12, 2)
  isPrimary   Boolean @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_ps_product")
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade, map: "fk_ps_supplier")

  @@id([productId, supplierId])
  @@index([supplierId])
  @@index([isPrimary])
  @@map("product_suppliers")
  @@schema("public")
}

// ─── Warehouses ──────────────────────────────────────────────────────────────

model Warehouse {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  city      String
  country   String
  capacity  Int
  createdAt DateTime @default(now()) @map("created_at")

  inventory  Inventory[]
  shipments  Shipment[]
  employees  Employee[]

  @@index([country])
  @@map("warehouses")
  @@schema("public")
}

// ─── Inventory (composite PK) ────────────────────────────────────────────────

model Inventory {
  variantId        Int       @map("variant_id")
  warehouseId      Int       @map("warehouse_id")
  quantityOnHand   Int       @default(0) @map("quantity_on_hand")
  quantityReserved Int       @default(0) @map("quantity_reserved")
  restockedAt      DateTime? @map("restocked_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "fk_inv_variant")
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade, map: "fk_inv_warehouse")

  @@id([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory")
  @@schema("public")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id               Int          @id @default(autoincrement())
  customerId       Int          @map("customer_id")
  placedAt         DateTime     @map("placed_at")
  status           OrderStatus  @default(PENDING)
  currency         String       @default("USD")
  channel          OrderChannel @default(WEB)
  shippingAddressId Int?        @map("shipping_address_id")
  cancelledAt      DateTime?    @map("cancelled_at")
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")

  customer         Customer     @relation(fields: [customerId], references: [id], map: "fk_order_customer")
  shippingAddress  Address?     @relation(fields: [shippingAddressId], references: [id], map: "fk_order_address")
  items            OrderItem[]
  payments         Payment[]
  shipment         Shipment?
  orderCoupons     OrderCoupon[]
  cart             Cart?

  @@index([customerId])
  @@index([status])
  @@index([placedAt])
  @@index([currency])
  @@index([channel])
  @@map("orders")
  @@schema("public")
}

// ─── Order Items (generated column line_total added in raw migration) ────────

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int     @map("order_id")
  variantId       Int     @map("variant_id")
  sellerId        Int     @map("seller_id") // denormalized for per-seller aggregation
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_oi_order")
  variant         ProductVariant @relation(fields: [variantId], references: [id], map: "fk_oi_variant")
  seller          Seller         @relation(fields: [sellerId], references: [id], map: "fk_oi_seller")
  returns         Return[]

  @@index([orderId])
  @@index([variantId])
  @@index([sellerId])
  @@map("order_items")
  @@schema("public")
}

// ─── Payments (multiple per order — row multiplication trap) ─────────────────

model Payment {
  id           Int           @id @default(autoincrement())
  orderId      Int           @map("order_id")
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime?     @map("paid_at")
  installments Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at")

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_payment_order")

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([paidAt])
  @@map("payments")
  @@schema("public")
}

// ─── Shipments ───────────────────────────────────────────────────────────────

model Shipment {
  id            Int       @id @default(autoincrement())
  orderId       Int       @unique @map("order_id")
  warehouseId   Int       @map("warehouse_id")
  carrier       String
  shippedAt     DateTime  @map("shipped_at")
  deliveredAt   DateTime? @map("delivered_at")
  trackingCode  String    @map("tracking_code")
  shippingCost  Decimal   @map("shipping_cost") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_shipment_order")
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], map: "fk_shipment_warehouse")

  @@index([warehouseId])
  @@index([carrier])
  @@index([shippedAt])
  @@index([deliveredAt])
  @@map("shipments")
  @@schema("public")
}

// ─── Returns ─────────────────────────────────────────────────────────────────

model Return {
  id            Int           @id @default(autoincrement())
  orderItemId   Int           @map("order_item_id")
  requestedAt   DateTime      @map("requested_at")
  reason        ReturnReason
  quantity      Int
  refundAmount  Decimal       @map("refund_amount") @db.Decimal(12, 2)
  status        ReturnStatus  @default(REQUESTED)
  resolvedAt    DateTime?     @map("resolved_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade, map: "fk_return_oi")

  @@index([orderItemId])
  @@index([reason])
  @@index([status])
  @@index([requestedAt])
  @@map("returns")
  @@schema("public")
}

// ─── Coupons ─────────────────────────────────────────────────────────────────

model Coupon {
  id              Int          @id @default(autoincrement())
  code            String       @unique
  discountType    DiscountType @map("discount_type")
  value           Decimal      @db.Decimal(12, 2)
  validFrom       DateTime     @map("valid_from")
  validTo         DateTime     @map("valid_to")
  maxUses         Int          @map("max_uses")
  minOrderAmount  Decimal      @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  createdAt       DateTime     @default(now()) @map("created_at")

  orderCoupons    OrderCoupon[]

  @@index([validFrom])
  @@index([validTo])
  @@map("coupons")
  @@schema("public")
}

// ─── Order Coupons (M:N orders <-> coupons) ──────────────────────────────────

model OrderCoupon {
  id              Int     @id @default(autoincrement())
  orderId         Int     @map("order_id")
  couponId        Int     @map("coupon_id")
  discountApplied Decimal @map("discount_applied") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_oc_order")
  coupon          Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade, map: "fk_oc_coupon")

  @@index([orderId])
  @@index([couponId])
  @@map("order_coupons")
  @@schema("public")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id                 Int      @id @default(autoincrement())
  productId          Int      @map("product_id")
  customerId         Int      @map("customer_id")
  rating             Int // 1–5, CHECK constraint in raw migration
  title              String
  body               String?
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  helpfulVotes       Int      @default(0) @map("helpful_votes")
  createdAt          DateTime @default(now()) @map("created_at")

  product            Product  @relation(fields: [productId], references: [id], map: "fk_review_product")
  customer           Customer @relation(fields: [customerId], references: [id], map: "fk_review_customer")

  @@index([productId])
  @@index([customerId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
  @@schema("public")
}

// ─── Employees (self-referencing manager chain) ──────────────────────────────

model Employee {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  department   EmployeeDepartment
  managerId    Int?      @map("manager_id") // self-reference
  manager      Employee? @relation("EmployeeManager", fields: [managerId], references: [id], map: "fk_employee_manager")
  reports      Employee[] @relation("EmployeeManager")
  salary       Decimal   @db.Decimal(10, 2)
  hiredAt      DateTime  @map("hired_at")
  terminatedAt DateTime? @map("terminated_at")
  warehouseId  Int?      @map("warehouse_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], map: "fk_employee_warehouse")

  @@index([managerId])
  @@index([department])
  @@index([warehouseId])
  @@index([terminatedAt])
  @@map("employees")
  @@schema("public")
}

// ─── Carts ───────────────────────────────────────────────────────────────────

model Cart {
  id          Int       @id @default(autoincrement())
  customerId  Int?      @map("customer_id") // nullable for guest carts
  sessionId   String    @unique @map("session_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  orderId     Int?      @unique @map("order_id") // set when converted

  customer    Customer?  @relation(fields: [customerId], references: [id], map: "fk_cart_customer")
  order       Order?     @relation(fields: [orderId], references: [id], map: "fk_cart_order")
  items       CartItem[]

  @@index([customerId])
  @@index([createdAt])
  @@index([orderId])
  @@map("carts")
  @@schema("public")
}

// ─── Cart Items ──────────────────────────────────────────────────────────────

model CartItem {
  id          Int     @id @default(autoincrement())
  cartId      Int     @map("cart_id")
  variantId   Int     @map("variant_id")
  quantity    Int
  addedAt     DateTime @default(now()) @map("added_at")

  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, map: "fk_ci_cart")
  variant     ProductVariant @relation(fields: [variantId], references: [id], map: "fk_ci_variant")

  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
  @@schema("public")
}

// ─── Page View Events (time series, BigInt id) ───────────────────────────────

model PageViewEvent {
  id          BigInt     @id @default(autoincrement())
  sessionId   String     @map("session_id")
  customerId  Int?       @map("customer_id")
  productId   Int?       @map("product_id")
  eventType   EventType  @map("event_type")
  occurredAt  DateTime   @map("occurred_at")
  device      DeviceType
  referrer    String?
  country     String
  createdAt   DateTime   @default(now()) @map("created_at")

  customer    Customer?  @relation(fields: [customerId], references: [id], map: "fk_event_customer")
  product     Product?   @relation(fields: [productId], references: [id], map: "fk_event_product")

  @@index([sessionId])
  @@index([customerId])
  @@index([productId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([device])
  @@map("page_view_events")
  @@schema("public")
}

// ─── Exchange Rates (range/non-equi joins) ───────────────────────────────────

model ExchangeRate {
  id         Int      @id @default(autoincrement())
  currency   String
  validFrom  DateTime @map("valid_from") @db.Date
  validTo    DateTime @map("valid_to") @db.Date
  rateToUsd  Decimal  @map("rate_to_usd") @db.Decimal(10, 6)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([currency])
  @@index([validFrom])
  @@index([validTo])
  @@map("exchange_rates")
  @@schema("public")
}

// ─── Daily Sales Snapshots (pre-aggregated for comparison) ───────────────────

model DailySalesSnapshot {
  id            Int      @id @default(autoincrement())
  snapshotDate  DateTime @map("snapshot_date") @db.Date
  sellerId      Int      @map("seller_id")
  ordersCount   Int      @map("orders_count")
  grossRevenue  Decimal  @map("gross_revenue") @db.Decimal(14, 2)
  itemsSold     Int      @map("items_sold")
  createdAt     DateTime @default(now()) @map("created_at")

  seller        Seller   @relation(fields: [sellerId], references: [id], map: "fk_dss_seller")

  @@unique([snapshotDate, sellerId])
  @@index([sellerId])
  @@index([snapshotDate])
  @@map("daily_sales_snapshots")
  @@schema("public")
}

// ─── Challenges (lab schema — invisible to the read-only role) ───────────────

enum ChallengeLevel {
  BEGINNER
  MID_LEVEL
  SENIOR
  EXPERT

  @@schema("lab")
}

enum ChallengeStatus {
  ATTEMPTED
  SOLVED

  @@schema("lab")
}

model Challenge {
  id            Int             @id @default(autoincrement())
  slug          String          @unique
  title         String
  level         ChallengeLevel
  orderIndex    Int             @map("order_index")
  /// Task statement shown to the user (plain text / light markdown, English).
  prompt        String
  /// Optional starter query loaded into the bound console.
  starterSql    String?         @map("starter_sql")
  /// Reference solution — NEVER sent to the client except via the reveal endpoint.
  solutionSql   String          @map("solution_sql")
  /// When true, row order is part of correctness.
  orderMatters  Boolean         @default(false) @map("order_matters")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  hints         ChallengeHint[]
  progress      ChallengeProgress?

  @@unique([level, orderIndex])
  @@index([level])
  @@map("challenges")
  @@schema("lab")
}

model ChallengeHint {
  id           Int       @id @default(autoincrement())
  challengeId  Int       @map("challenge_id")
  position     Int
  text         String

  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade, map: "fk_hint_challenge")

  @@unique([challengeId, position])
  @@index([challengeId])
  @@map("challenge_hints")
  @@schema("lab")
}

/// Single-user global progress: at most one row per challenge.
model ChallengeProgress {
  id                Int             @id @default(autoincrement())
  challengeId       Int             @unique @map("challenge_id")
  status            ChallengeStatus
  attempts          Int             @default(0)
  lastSql           String?         @map("last_sql")
  lastLanguage      String?         @map("last_language")
  solvedAt          DateTime?       @map("solved_at")
  revealedResult    Boolean         @default(false) @map("revealed_result")
  revealedHints     Int             @default(0) @map("revealed_hints")
  revealedSolution  Boolean         @default(false) @map("revealed_solution")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  challenge         Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade, map: "fk_progress_challenge")

  @@map("challenge_progress")
  @@schema("lab")
}
