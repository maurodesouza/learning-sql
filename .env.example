# PostgreSQL (docker compose) — local dev only, safe to commit as an example.
POSTGRES_USER=learning
POSTGRES_PASSWORD=learning
POSTGRES_DB=learning_sql
POSTGRES_PORT=5432
# Password for the read-only role used by the query console.
SQL_LAB_READONLY_PASSWORD=readonly

# Owner connection — used by Prisma (migrations + seed).
DATABASE_URL=postgresql://learning:learning@localhost:5432/learning_sql?schema=public

# Read-only connection — used by the query console API (sql_lab_readonly role).
DATABASE_URL_READONLY=postgresql://sql_lab_readonly:readonly@localhost:5432/learning_sql?schema=public

# Query console limits.
QUERY_TIMEOUT_MS=5000
QUERY_MAX_ROWS=1000

# Optional: seed a ~10x smaller dataset for quick iteration (small | full).
SEED_SCALE=full
